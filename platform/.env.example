# ---- Banco de dados ----
DATABASE_URL="postgresql://motora:motora@localhost:5432/motora?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=3333
JWT_ACCESS_SECRET="troque-em-producao"
JWT_REFRESH_SECRET="troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:3000"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ---- OAuth / Login social (opcional) ----
# Preencha o par client id/secret para habilitar cada provedor. Redirect URI:
#   {API_PUBLIC_URL}/api/auth/oauth/<provider>/callback
API_PUBLIC_URL="http://localhost:3333"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Seam de teste da lógica de conta OAuth sem provedor real (NÃO usar em produção):
OAUTH_DEV_LOGIN="false"

# ---- E-mail transacional ----
# Sem provedor, o envio apenas registra no log (dev). Defina para plugar SMTP/API.
MAIL_PROVIDER=""
# Seam de teste: expõe o token de reset/verificação no corpo da resposta (NÃO usar
# em produção). Permite validar o fluxo sem um provedor de e-mail real.
AUTH_DEV_EXPOSE_TOKENS="false"

# ---- IA (opcional) ----
# Sem chave, a geração de descrição usa fallback determinístico (template).
# Com chave, chama um provedor compatível com a Messages API da Anthropic.
AI_API_KEY=""
AI_BASE_URL="https://api.anthropic.com"
AI_MODEL="claude-sonnet-5"

# ---- Cloud Storage ----
# Em produção: bucket S3-compatível (URL pré-assinada). Em dev, provider local:
STORAGE_BUCKET=""
STORAGE_DIR=""                                   # pasta local (dev); vazio = tmp do SO
STORAGE_PUBLIC_URL="http://localhost:3333"       # base pública dos objetos
