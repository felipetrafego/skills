# ---- Banco de dados ----
DATABASE_URL="postgresql://motora:motora@localhost:5432/motora?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=3333
JWT_ACCESS_SECRET="troque-em-producao"
JWT_REFRESH_SECRET="troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:3000"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ---- OAuth (opcional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Cloud Storage ----
# Em produção: bucket S3-compatível (URL pré-assinada). Em dev, provider local:
STORAGE_BUCKET=""
STORAGE_DIR=""                                   # pasta local (dev); vazio = tmp do SO
STORAGE_PUBLIC_URL="http://localhost:3333"       # base pública dos objetos
